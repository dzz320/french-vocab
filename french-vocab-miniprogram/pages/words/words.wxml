<view class="page-pad safe-bottom">
  <view wx:if="{{!signedIn}}" class="card state-block">
    <view class="state-icon"><text class="state-icon-text">📓</text></view>
    <view class="state-title">请先登录</view>
    <view class="state-desc">登录后即可管理你的生词本</view>
    <button class="btn btn-wechat btn-block" bindtap="goLogin">微信一键登录</button>
  </view>

  <block wx:elif="{{loading && list.length === 0}}">
    <view class="card"><view class="loading-dots"><text class="faint">正在加载生词…</text></view></view>
  </block>

  <block wx:elif="{{error && list.length === 0}}">
    <view class="card state-block">
      <view class="state-title">加载失败</view>
      <view class="state-desc">{{error}}</view>
      <button class="btn btn-ghost" bindtap="reload">重试</button>
    </view>
  </block>

  <block wx:else>
    <view class="row search-row">
      <view class="flex-1">
        <input
          class="input search-input"
          placeholder="搜索单词或释义"
          value="{{search}}"
          bindinput="onSearchInput"
          confirm-type="search"
        />
      </view>
      <button class="btn btn-primary btn-sm add-btn" bindtap="goAdd">＋ 生词</button>
    </view>

    <!-- 词库筛选：按「B1 库 / 工程师库」这类自建分组看词 -->
    <scroll-view scroll-x class="chip-scroll lib-bar">
      <view class="chip-row">
        <view class="filter-chip {{libraryFilter === 'all' ? 'on' : ''}}" bindtap="setLibrary" data-filter="all">全部词库</view>
        <view
          wx:for="{{libraries}}"
          wx:key="id"
          class="filter-chip {{libraryFilter === item.key ? 'on' : ''}}"
          bindtap="setLibrary"
          data-filter="{{item.key}}"
        >{{item.name}}</view>
        <view class="filter-chip {{libraryFilter === 'none' ? 'on' : ''}}" bindtap="setLibrary" data-filter="none">未分组</view>
        <view class="filter-chip filter-chip-dashed" bindtap="goLibraries">＋ 词库管理</view>
      </view>
    </scroll-view>

    <view class="row filter-row">
      <view class="filter-chip {{statusFilter === '' ? 'on' : ''}}" bindtap="setFilter" data-status="">全部</view>
      <view class="filter-chip {{statusFilter === 'learning' ? 'on' : ''}}" bindtap="setFilter" data-status="learning">学习中</view>
      <view class="filter-chip {{statusFilter === 'mastered' ? 'on' : ''}}" bindtap="setFilter" data-status="mastered">已掌握</view>
      <view class="flex-1"></view>
      <button class="btn btn-ghost btn-sm import-btn" bindtap="goImport">导入</button>
    </view>

    <view wx:if="{{list.length === 0}}" class="card state-block">
      <view class="state-icon"><text class="state-icon-text">✏️</text></view>
      <view class="state-title">{{search ? '没有找到匹配的生词' : (libraryFilter === 'all' ? '生词本还是空的' : '这个词库里还没有生词')}}</view>
      <view class="state-desc" wx:if="{{!search}}">导入 CSV / Excel 词表、手动添加，或从教材导入</view>
      <view class="row empty-actions" wx:if="{{!search}}">
        <button class="btn btn-primary flex-1" bindtap="goImport">导入词表</button>
        <button class="btn btn-ghost flex-1" bindtap="goAdd">添加生词</button>
      </view>
      <view class="tiny faint sample-link" wx:if="{{!search}}" bindtap="fillSamples">或先填充几个示例词试试</view>
    </view>

    <view
      class="word-card"
      wx:for="{{list}}"
      wx:key="id"
      bindtap="openWord"
      data-id="{{item.id}}"
    >
      <view class="row">
        <view class="word-flag {{item.status === 'mastered' ? 'flag-mastered' : ''}}"></view>
        <view class="col flex-1">
          <view class="row between">
            <view class="word-fr ellipsis">{{item.word}}</view>
            <view class="tag {{item.status === 'mastered' ? 'tag-green' : 'tag-gray'}}">{{item.stageLabel}}</view>
          </view>
          <view class="word-zh ellipsis">
            <text wx:if="{{item.pos}}" class="faint">{{item.pos}} </text>{{item.meaning_zh || '（暂无释义，点入补全）'}}
          </view>
        </view>
        <!-- catchtap：点喇叭只发音，不要顺带跳进详情页 -->
        <view
          class="speak-btn speak-btn-row {{playingKey === item.key ? 'speaking' : ''}}"
          catchtap="speakWord"
          data-id="{{item.id}}"
          data-word="{{item.word}}"
        >🔊</view>
      </view>
    </view>

    <view class="load-more" wx:if="{{hasMore}}">
      <text class="tiny faint" bindtap="loadMore">{{loadingMore ? '加载中…' : '加载更多'}}</text>
    </view>
    <view class="load-more" wx:elif="{{list.length > 8}}">
      <text class="tiny faint">共 {{total}} 个生词</text>
    </view>
  </block>
</view>
