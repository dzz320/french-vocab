<view class="page-pad safe-bottom">
  <!-- 未登录 -->
  <view wx:if="{{!signedIn}}" class="card state-block">
    <view class="state-icon"><text class="state-icon-text">📚</text></view>
    <view class="state-title">请先登录</view>
    <view class="state-desc">登录后即可上传教材并生成学习日程</view>
    <button class="btn btn-wechat btn-block" bindtap="goLogin">微信一键登录</button>
  </view>

  <block wx:elif="{{loading}}">
    <view class="card"><view class="loading-dots"><text class="faint">正在加载教材…</text></view></view>
  </block>

  <block wx:elif="{{error}}">
    <view class="card state-block">
      <view class="state-title">加载失败</view>
      <view class="state-desc">{{error}}</view>
      <button class="btn btn-ghost" bindtap="refresh">重试</button>
    </view>
  </block>

  <block wx:else>
    <button class="btn btn-primary btn-block btn-lg upload-btn" bindtap="goUpload">＋ 上传教材</button>
    <view class="small faint tip-line">支持拍照/相册图片、PDF/Word 文档、文本粘贴</view>

    <view wx:if="{{books.length === 0}}" class="card state-block">
      <view class="state-icon"><text class="state-icon-text">📖</text></view>
      <view class="state-title">还没有教材</view>
      <view class="state-desc">上传教材后，AI 会识别单元与生词表，\n并按单元为你生成学习日程</view>
      <button class="btn btn-ghost" bindtap="goUpload">上传第一本教材</button>
    </view>

    <view wx:for="{{books}}" wx:key="id" class="card book-card" bindtap="openBook" data-id="{{item.id}}">
      <view class="row between">
        <view class="col flex-1">
          <view class="strong ellipsis">{{item.title}}</view>
          <view class="small muted">{{item.unitCount}} 个单元 · {{item.sourceLabel}}</view>
        </view>
        <view class="tag tag-green" wx:if="{{item.percent >= 100}}">已完成</view>
        <view class="tag" wx:else>{{item.percent}}%</view>
      </view>
      <view class="progress book-progress">
        <view class="progress-bar" style="width: {{item.percent}}%"></view>
      </view>
      <view class="row between book-stats">
        <view class="tiny faint">共 {{item.stats.total}} 词</view>
        <view class="tiny faint">已掌握 {{item.stats.mastered}}</view>
        <view class="tiny faint">待学 {{item.stats.fresh}}</view>
      </view>
    </view>
  </block>
</view>
