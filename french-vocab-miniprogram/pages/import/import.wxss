.hint {
  margin-bottom: 20rpx;
}
.lib-title {
  margin: 8rpx 0 12rpx;
}
.chip-count {
  opacity: 0.6;
  font-size: 22rpx;
}
.new-lib-pick {
  margin-top: 6rpx;
}
.new-lib-name {
  margin-top: 14rpx;
}
.lib-level-label {
  margin-top: 22rpx;
}
.lib-tip {
  margin-top: 14rpx;
}
.import-area {
  min-height: 260rpx;
  margin-bottom: 24rpx;
}
.size-note {
  margin-top: 12rpx;
}
.note-line {
  margin-top: 8rpx;
}
.warn-box {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-sm);
  background: var(--orange-soft);
  color: var(--orange);
  font-size: 24rpx;
  line-height: 1.6;
}

/* 列映射 */
.map-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
}
.map-row + .map-row {
  border-top: 1rpx solid var(--line);
}
.map-label {
  font-size: 28rpx;
  color: var(--text);
}
.map-req {
  color: var(--accent);
}
.map-value {
  max-width: 360rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 25rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.map-value-off {
  background: #F1F3F8;
  color: var(--text-3);
}
.raw-preview {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-sm);
  background: #F7F8FC;
}
.raw-line {
  margin-top: 8rpx;
  color: var(--text-2);
  word-break: break-all;
}

/* 预览列表 */
.bulk-row {
  margin-top: 16rpx;
}
.preview-card {
  display: block;
  padding: 24rpx 30rpx;
}
.meta-row {
  margin-top: 8rpx;
}
.meta-row text {
  margin-right: 18rpx;
}
.save-row {
  margin-top: 8rpx;
}
.save-row .btn + .btn {
  margin-left: 18rpx;
}
