.login-error {
  margin-top: 20rpx;
  color: var(--accent);
}
.user-card {
  display: flex;
  align-items: center;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(140deg, #2a4c9b, #1e3a8a);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.no-margin {
  margin-bottom: 0;
}
.chart-title {
  margin-top: 30rpx;
}
.chart {
  display: flex;
  align-items: flex-end;
  height: 220rpx;
  padding-top: 20rpx;
}
.chart-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}
.chart-count {
  font-size: 20rpx;
  color: var(--text-3);
  margin-bottom: 6rpx;
  min-height: 28rpx;
}
.chart-bar {
  width: 26rpx;
  min-height: 6rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: var(--brand);
  opacity: 0.85;
}
.chart-label {
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 12rpx;
}
.chart-empty {
  margin-top: 16rpx;
}
.advice {
  margin-top: 20rpx;
  padding: 22rpx;
  background: var(--brand-soft);
  border-radius: var(--radius);
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--text);
  white-space: pre-line;
}
.logout-btn {
  margin-top: 12rpx;
}
.audio-hint {
  margin-top: 18rpx;
  line-height: 1.6;
}
.about {
  text-align: center;
  margin-top: 30rpx;
}
