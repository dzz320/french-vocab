/* ========== 主题变量 ========== */
page {
  --brand: #2A4C9B;
  --brand-strong: #1E3A8A;
  --brand-soft: #EEF2FB;
  --brand-border: #D9E2F5;
  --accent: #D64545;
  --accent-soft: #FDEEEE;
  --bg: #F4F6FB;
  --card: #FFFFFF;
  --text: #1F2533;
  --text-2: #6B7280;
  --text-3: #9AA3B2;
  --line: #E7EAF2;
  --green: #2F9E6E;
  --green-soft: #E9F7F1;
  --orange: #D9822B;
  --orange-soft: #FDF3E6;
  --radius-lg: 28rpx;
  --radius: 20rpx;
  --radius-sm: 14rpx;
  --shadow: 0 6rpx 24rpx rgba(42, 76, 155, 0.08);

  background-color: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
    "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

/* ========== 布局 ========== */
.page-pad {
  padding: 24rpx 28rpx 48rpx;
}
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.col {
  display: flex;
  flex-direction: column;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}
.between {
  justify-content: space-between;
}
.center {
  justify-content: center;
  align-items: center;
}
.wrap {
  flex-wrap: wrap;
}
.safe-bottom {
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ========== 卡片与分区 ========== */
.card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 30rpx;
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
}
.card-plain {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 30rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin: 8rpx 0 20rpx;
}
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}

/* ========== 文本 ========== */
.h1 {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text);
}
.h2 {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}
.muted {
  color: var(--text-2);
}
.faint {
  color: var(--text-3);
}
.small {
  font-size: 24rpx;
}
.tiny {
  font-size: 22rpx;
}
.strong {
  font-weight: 600;
}
.brand-text {
  color: var(--brand);
}
.accent-text {
  color: var(--accent);
}
.green-text {
  color: var(--green);
}
.orange-text {
  color: var(--orange);
}
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ========== 按钮 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  padding: 20rpx 36rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 1.4;
}
.btn::after {
  border: none;
}
.btn-primary {
  background: var(--brand);
  color: #ffffff;
}
.btn-primary:active {
  background: var(--brand-strong);
}
.btn-ghost {
  background: var(--brand-soft);
  color: var(--brand);
}
.btn-outline {
  background: transparent;
  color: var(--brand);
  border: 2rpx solid var(--brand-border);
}
.btn-danger {
  background: var(--accent-soft);
  color: var(--accent);
}
.btn-wechat {
  background: #07c160;
  color: #ffffff;
}
.btn-block {
  width: 100%;
}
.btn-lg {
  padding: 26rpx 40rpx;
  font-size: 32rpx;
}
.btn-sm {
  padding: 12rpx 26rpx;
  font-size: 26rpx;
}
.btn-disabled {
  opacity: 0.45;
}

/* ========== 标签 / 徽标 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--brand-soft);
  color: var(--brand);
}
.tag-green {
  background: var(--green-soft);
  color: var(--green);
}
.tag-orange {
  background: var(--orange-soft);
  color: var(--orange);
}
.tag-accent {
  background: var(--accent-soft);
  color: var(--accent);
}
.tag-gray {
  background: #F1F3F8;
  color: var(--text-2);
}
.badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== 表单 ========== */
.input {
  background: #F7F8FC;
  border-radius: var(--radius);
  /* 微信 input 组件默认高度只有约 1.4rem，配大 padding 会把文字上半截裁掉；
     必须显式给高、行高与高一致（单行场景全部适用：原生 input 与 picker 展示层） */
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 26rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
  width: 100%;
}
.textarea {
  background: #F7F8FC;
  border-radius: var(--radius);
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  color: var(--text);
  width: 100%;
  min-height: 220rpx;
  box-sizing: border-box;
  line-height: 1.6;
}
.field {
  margin-bottom: 26rpx;
}
.field-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}
.field-label.no-margin {
  margin-bottom: 0;
}
/* picker 的展示层：复用 .input 外观，保证与输入框对齐 */
.picker-value {
  color: var(--text);
}
.picker-value-off {
  color: var(--text-3);
}

/* ========== 空态 / 加载 / 错误 ========== */
.state-block {
  padding: 90rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.state-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}
.state-icon-text {
  font-size: 52rpx;
  color: var(--brand);
}
.state-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}
.state-desc {
  font-size: 26rpx;
  color: var(--text-3);
  margin-bottom: 34rpx;
}
.loading-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}
.skeleton {
  background: #ECEFF6;
  border-radius: var(--radius-sm);
}

/* ========== 进度条 ========== */
.progress {
  height: 14rpx;
  background: #ECEFF6;
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: var(--brand);
}
.progress-bar-green {
  background: var(--green);
}

/* ========== 统计 ========== */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
}
.stat-cell {
  width: 50%;
  box-sizing: border-box;
  padding: 20rpx 12rpx;
  text-align: center;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--brand);
  line-height: 1.2;
}
.stat-label {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

/* ========== 筛选芯片（生词本词库筛选 / 导入目标 / 词库管理共用） ========== */
.chip-scroll {
  width: 100%;
  white-space: nowrap;
}
.chip-row {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 4rpx 0 8rpx;
}
.filter-chip {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--text-2);
  font-size: 26rpx;
  margin-right: 16rpx;
  box-shadow: var(--shadow);
  white-space: nowrap;
  flex-shrink: 0;
}
.filter-chip.on {
  background: var(--brand);
  color: #ffffff;
}
.filter-chip-dashed {
  background: transparent;
  border: 2rpx dashed var(--brand-border);
  color: var(--brand);
  box-shadow: none;
}

/* ========== 词条行编辑（教材校正页与导入预览页共用） ========== */
.word-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #cdd5e5;
  margin: 20rpx 18rpx 0 0;
  box-sizing: border-box;
  flex-shrink: 0;
}
.word-check.on {
  background: var(--brand);
  border-color: var(--brand);
  position: relative;
}
.word-check.on::after {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 5rpx;
  width: 10rpx;
  height: 18rpx;
  border-right: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(45deg);
}
.word-inputs {
  align-items: center;
}
.word-input {
  padding: 14rpx 20rpx;
  font-size: 26rpx;
}
.word-input + .word-input {
  margin-left: 12rpx;
}
.word-del {
  font-size: 40rpx;
  color: var(--text-3);
  line-height: 1;
  padding: 16rpx 0 16rpx 18rpx;
}
.error-card {
  border: 1rpx solid #f6cfd0;
}

/* ========== 单词卡片 ========== */
.word-card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}
.word-fr {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
}
.word-zh {
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 6rpx;
}
.word-flag {
  width: 8rpx;
  height: 56rpx;
  border-radius: 4rpx;
  background: var(--brand);
  margin-right: 22rpx;
}

/* ========== 发音按钮 ========== */
/* 圆形喇叭：学习卡片 / 生词列表共用 */
.speak-btn {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  border: 2rpx solid var(--brand-border);
  color: var(--brand);
  font-size: 34rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.speak-btn:active {
  background: var(--brand-border);
}
.speak-btn.speaking {
  background: var(--brand);
  border-color: var(--brand);
  animation: speak-pulse 1.1s ease-in-out infinite;
}
.speak-btn-sm {
  width: 56rpx;
  height: 56rpx;
  font-size: 28rpx;
}
.speak-btn-inline {
  margin-left: 18rpx;
}
.speak-btn-row {
  width: 60rpx;
  height: 60rpx;
  font-size: 30rpx;
  margin-left: 16rpx;
}
@keyframes speak-pulse {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(42, 76, 155, 0.32);
  }
  50% {
    box-shadow: 0 0 0 12rpx rgba(42, 76, 155, 0);
  }
}

/* 胶囊型发音按钮：生词详情页「读单词 / 读例句」 */
.speak-bar {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}
.speak-pill {
  display: flex;
  align-items: center;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  border: 2rpx solid var(--brand-border);
  color: var(--brand);
  font-size: 26rpx;
  line-height: 1.3;
}
.speak-pill + .speak-pill {
  margin-left: 20rpx;
}
.speak-pill:active {
  background: var(--brand-border);
}
.speak-pill.speaking {
  background: var(--brand);
  border-color: var(--brand);
  color: #ffffff;
}
/* 内容为空时按钮仍在位，只是灰掉 —— 比「按钮凭空消失」好理解 */
.speak-pill-off {
  background: #f2f4f8;
  border-color: var(--line);
  color: var(--text-3);
}

/* 我的 - 设置行 */
.set-row {
  padding: 20rpx 0;
}
.set-row + .set-row {
  border-top: 2rpx solid var(--line);
}
.set-hint {
  margin-top: 2rpx;
}

